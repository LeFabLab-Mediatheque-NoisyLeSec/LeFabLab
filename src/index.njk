---
layout: layouts/base.njk
---
<div class="accueil-haut">
  <section class="hero" aria-labelledby="h-presentation">
    <h1 id="h-presentation">{{ site.nom }}</h1>
    <p class="chapo">{{ site.intro_accueil }}</p>

  </section>

  {% if ateliers_proposes.liste and ateliers_proposes.liste.length %}
  <aside class="encart-ateliers" aria-labelledby="h-ateliers-proposes">
    <h2 id="h-ateliers-proposes">{{ ateliers_proposes.titre or "Ateliers proposés" }}</h2>
    {% if ateliers_proposes.intro %}<p class="encart-intro">{{ ateliers_proposes.intro }}</p>{% endif %}
    <ul>
      {% for a in ateliers_proposes.liste %}
      <li>
        <span class="encart-nom">{{ a.nom }}</span>
        {% if a.details %}<span class="encart-details">{{ a.details }}</span>{% endif %}
      </li>
      {% endfor %}
    </ul>
    <a class="lien-suite" href="/ateliers/">Retours des ateliers passés →</a>
  </aside>
  {% endif %}
</div>

<section class="rangee" aria-labelledby="h-machines">
  <div class="rangee-tete">
    <h2 id="h-machines">Les machines</h2>
    <a class="lien-suite" href="/machines/">Toutes les machines →</a>
  </div>
  <ul class="cartes cartes-4">
    {% for m in collections.machines %}
    <li class="carte">
      {% if m.data.image %}<img src="{{ m.data.image }}" alt="" loading="lazy">{% endif %}
      <div class="carte-corps">
        <h3><a href="{{ m.url }}">{{ m.data.title }}</a></h3>
        {% if m.data.description %}<p>{{ m.data.description }}</p>{% endif %}
      </div>
    </li>
    {% endfor %}
  </ul>
</section>

{% set derniersTutos = collections.tutoriels | plusRecents | limite(4) %}
{% if derniersTutos.length %}
<section class="rangee" aria-labelledby="h-tutoriels">
  <div class="rangee-tete">
    <h2 id="h-tutoriels">Derniers tutoriels</h2>
    <a class="lien-suite" href="/tutoriels/">Tous les tutoriels →</a>
  </div>
  <ul class="cartes cartes-4">
    {% for t in derniersTutos %}{% include "partials/carte-tuto.njk" %}{% endfor %}
  </ul>
</section>
{% endif %}

{% set derniersAteliers = collections.ateliers | limite(4) %}
{% if derniersAteliers.length %}
<section class="rangee" aria-labelledby="h-ateliers">
  <div class="rangee-tete">
    <h2 id="h-ateliers">Derniers ateliers</h2>
    <a class="lien-suite" href="/ateliers/">Tous les ateliers →</a>
  </div>
  <ul class="cartes cartes-4">
    {% for a in derniersAteliers %}{% include "partials/carte-atelier.njk" %}{% endfor %}
  </ul>
</section>
{% endif %}
